        "z": "tab_magenta_analyzer_complete",
        "name": "Pfad & Befehl bauen",
        "func": "let file = msg.req.query.file;\nlet date = msg.req.query.date;\n\nif (!file || !date) {\n    msg.statusCode = 400;\n    msg.payload = { status: \"error\", message: \"Parameter fehlen\" };\n    return [null, msg];\n}\n\ndate = date.replace(/-/g, '_');\nlet fullPath = `/home/pi/project/zarpy/rec/magentatv/${date}/${file}`;\n\nlet execMsg = {\n    payload: `DISPLAY=:0 audacity \"${fullPath}\" >/dev/null 2>&1 &`\n};\n\nlet responseMsg = {\n    statusCode: 200,\n    headers: { \"Content-Type\": \"application/json\" },\n    payload: { status: \"ok\", file: fullPath }\n};\n\nreturn [execMsg, responseMsg];",
        "outputs": 2,
        "noerr": 0,
