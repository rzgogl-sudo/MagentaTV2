        "z": "tab_magenta_analyzer_complete",
        "name": "Verarbeiten & Speichern",
        "func": "let method = msg.req.method;\nlet query = msg.req.query;\nlet cfg = {};\n\ntry {\n    if (typeof msg.payload === 'string') {\n        cfg = JSON.parse(msg.payload);\n    } else if (typeof msg.payload === 'object') {\n        cfg = msg.payload;\n    }\n} catch(e) {\n    cfg = {};\n}\n\nfunction getSvc(s) {\n    if (!cfg[s]) {\n        cfg[s] = { disabled: false, periods: [] };\n    } else if (Array.isArray(cfg[s])) {\n        cfg[s] = { disabled: false, periods: cfg[s] };\n    }\n    return cfg[s];\n}\n\nlet writeToFile = false;\nmsg.statusCode = 200;\n\nif (method === \"GET\") {\n    msg.payload = cfg;\n} else if (method === \"POST\") {\n    let svc = query.service;\n    if (!svc) {\n        msg.payload = {error: \"Missing service\"};\n        msg.statusCode = 400;\n    } else {\n        let item = getSvc(svc);\n        if (query.toggle_disabled !== undefined) {\n            item.disabled = (query.toggle_disabled === \"true\" || query.toggle_disabled === \"1\");\n            writeToFile = true;\n            msg.payload = cfg;\n        } else if (query.start && query.end) {\n            item.periods.push({start: query.start, end: query.end});\n            writeToFile = true;\n            msg.payload = cfg;\n        } else {\n            msg.payload = {error: \"Missing params\"};\n            msg.statusCode = 400;\n        }\n    }\n} else if (method === \"DELETE\") {\n    let svc = query.service;\n    if (svc && cfg[svc]) {\n        let item = getSvc(svc);\n        if (query.index !== undefined && query.index !== \"\") {\n            let idx = parseInt(query.index);\n            if (!isNaN(idx) && idx >= 0 && idx < item.periods.length) {\n                item.periods.splice(idx, 1);\n                writeToFile = true;\n            }\n        } else if (query.all === \"true\") {\n            delete cfg[svc];\n            writeToFile = true;\n        }\n        msg.payload = cfg;\n    } else {\n        msg.payload = {error: \"Service not found\"};\n        msg.statusCode = 400;\n    }\n}\n\nlet fileMsg = null;\nif (writeToFile) {\n    fileMsg = { payload: JSON.stringify(cfg, null, 2) };\n}\n\nreturn [fileMsg, msg];",
